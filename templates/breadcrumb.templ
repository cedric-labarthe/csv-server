package templates

import (
	"csv-server/components/breadcrumb"
	"strings"
)

templ Breadcrumb(currentPath string) {
	@breadcrumb.Breadcrumb() {
		@breadcrumb.List() {
			@breadcrumb.Item() {
				@breadcrumb.Link(breadcrumb.LinkProps{Href: "/"}) {
					root
				}
			}
			if currentPath != "" {
				for i, segment := range strings.Split(currentPath, "/") {
					@breadcrumb.Item() {
						@breadcrumb.Separator()
					}
					if i < len(strings.Split(currentPath, "/"))-1 {
						@breadcrumb.Item() {
							@breadcrumb.Link(breadcrumb.LinkProps{Href: "/browse/" + strings.Join(strings.Split(currentPath, "/")[:i+1], "/")}) {
								{ segment }
							}
						}
					} else {
						@breadcrumb.Item(breadcrumb.ItemProps{Current: true}) {
							@breadcrumb.Page() {
								{ segment }
							}
						}
					}
				}
			}
		}
	}
}

func breadcrumbTitle(currentPath string) string {
	if currentPath == "" {
		return "CSV Viewer"
	}
	parts := strings.Split(currentPath, "/")
	return parts[len(parts)-1]
}

func joinPath(base, name string) string {
	if base == "" {
		return name
	}
	return base + "/" + name
}
