package templates

import (
	"csv-server/components/badge"
	"csv-server/components/button"
	"csv-server/components/card"
	"csv-server/components/icon"
	"csv-server/internal/csv"
	"fmt"
)

templ Index(currentPath string, entries []csv.Entry) {
	@layout(breadcrumbTitle(currentPath)) {
		<header>
			@Breadcrumb(currentPath)
			@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
				{ fmt.Sprintf("%d item(s)", len(entries)) }
			}
		</header>
		@card.Card(card.Props{Class: "flex-1 overflow-hidden"}) {
			@card.Content(card.ContentProps{Class: "h-full overflow-y-auto"}) {
				if len(entries) == 0 {
					<p class="empty">No CSV files or directories found here.</p>
				} else {
					<ul class="flex flex-col gap-1">
						for _, entry := range entries {
							if entry.IsDir {
								@entryItem(entryItemProps{name: entry.Name, href: "/browse/" + joinPath(currentPath, entry.Name), isDir: true})
							} else {
								@entryItem(entryItemProps{name: entry.Name, href: "/view/" + joinPath(currentPath, entry.Name), isDir: false})
							}
						}
					</ul>
				}
			}
		}
	}
}

type entryItemProps struct {
	name  string
	href  string
	isDir bool
}

templ entryItem(props entryItemProps) {
	<li class="rounded-md border border-gray-200 overflow-hidden">
		if props.isDir {
			@button.Button(button.Props{Variant: button.VariantGhost, Href: props.href, FullWidth: true, Class: "justify-start gap-2 hover:bg-gray-100 font-medium"}) {
				@icon.Folder(icon.Props{Size: 16, Class: "text-amber-500"})
				{ props.name }
			}
		} else {
			@button.Button(button.Props{Variant: button.VariantGhost, Href: props.href, FullWidth: true, Class: "justify-start gap-2 hover:bg-gray-100"}) {
				@icon.File(icon.Props{Size: 16, Class: "text-blue-400"})
				{ props.name }
			}
		}
	</li>
}