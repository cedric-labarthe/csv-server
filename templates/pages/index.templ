package pages

import (
	"csv-server/components/badge"
	"csv-server/components/card"
	"csv-server/internal/csv"
	"csv-server/templates/components"
	"fmt"
)

type IndexProps struct {
	CurrentPath string
	Entries     []csv.Entry
}

templ Index(props IndexProps) {
	@components.Layout(components.LayoutProps{Title: components.BreadcrumbTitle(props.CurrentPath)}) {
		<header>
			<div class="header-top">
				@components.Breadcrumb(components.BreadcrumbProps{CurrentPath: props.CurrentPath})
				@components.DarkModeToggle()
			</div>
			@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
				{ fmt.Sprintf("%d item(s)", len(props.Entries)) }
			}
		</header>
		@card.Card(card.Props{Class: "flex-1 overflow-hidden"}) {
			@card.Content(card.ContentProps{Class: "h-full overflow-y-auto"}) {
				if len(props.Entries) == 0 {
					<p class="empty">No CSV files or directories found here.</p>
				} else {
					<ul class="flex flex-col gap-1">
						for _, entry := range props.Entries {
							if entry.IsDir {
								@components.EntryItem(components.EntryItemProps{Name: entry.Name, Href: "/browse/" + components.JoinPath(props.CurrentPath, entry.Name), IsDir: true})
							} else {
								@components.EntryItem(components.EntryItemProps{Name: entry.Name, Href: "/view/" + components.JoinPath(props.CurrentPath, entry.Name), IsDir: false})
							}
						}
					</ul>
				}
			}
		}
	}
}
