package pages

import (
	"csv-server/components/badge"
	"csv-server/components/button"
	"csv-server/components/card"
	"csv-server/components/icon"
	"csv-server/components/table"
	"csv-server/templates/components"
	"fmt"
)

type TableProps struct {
	Filename string
	Headers  []string
	Rows     [][]string
}

templ Table(props TableProps) {
	@components.Layout(components.LayoutProps{Title: props.Filename}) {
		<header>
			<div class="header-top">
				@button.Button(button.Props{Variant: button.VariantGhost, Href: parentURL(props.Filename)}) {
					@icon.ArrowLeft(icon.Props{Size: 16})
					Back to file list
				}
				@components.DarkModeToggle()
			</div>
			<h1>{ props.Filename }</h1>
			@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
				{ fmt.Sprintf("%d row(s) · %d column(s)", len(props.Rows), len(props.Headers)) }
			}
		</header>
		@card.Card(card.Props{Class: "flex-1 overflow-hidden flex flex-col"}) {
			@card.Content(card.ContentProps{Class: "flex-1 p-0 overflow-hidden flex flex-col"}) {
				if len(props.Headers) == 0 {
					<p class="empty p-6">This file is empty.</p>
				} else {
					<div class="overflow">
						@table.Table() {
							@table.Header() {
								@table.Row() {
									for _, header := range props.Headers {
										@table.Head() {
											{ header }
										}
									}
								}
							}
							@table.Body() {
								for _, row := range props.Rows {
									@table.Row() {
										for _, cell := range row {
											@table.Cell(table.CellProps{Attributes: templ.Attributes{"title": cell}}) {
												<div class="cell-inner">
													<span class="cell-text">{ truncate(cell, maxCellChars) }</span>
													@components.CopyButton(components.CopyButtonProps{Value: cell})
												</div>
											}
										}
									}
								}
							}
						}
					</div>
				}
			}
		}
	}
}
