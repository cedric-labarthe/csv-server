package templates

import (
	"csv-server/components/badge"
	"csv-server/components/button"
	"csv-server/components/card"
	"csv-server/components/icon"
	"csv-server/components/table"
	"fmt"
	"path"
	"unicode/utf8"
)

const maxCellChars = 100

templ Table(filename string, headers []string, rows [][]string) {
	@layout(filename) {
		<header>
			@button.Button(button.Props{Variant: button.VariantGhost, Href: parentURL(filename)}) {
				@icon.ArrowLeft(icon.Props{Size: 16})
				Back to file list
			}
			<h1>{ filename }</h1>
			@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
				{ fmt.Sprintf("%d row(s) · %d column(s)", len(rows), len(headers)) }
			}
		</header>
		@card.Card(card.Props{Class: "flex-1 overflow-hidden flex flex-col"}) {
			@card.Content(card.ContentProps{Class: "flex-1 p-0 overflow-hidden flex flex-col"}) {
				if len(headers) == 0 {
					<p class="empty p-6">This file is empty.</p>
				} else {
					<div class="overflow">
						@table.Table() {
							@table.Header() {
								@table.Row() {
									for _, header := range headers {
										@table.Head() {
											{ header }
										}
									}
								}
							}
							@table.Body() {
								for _, row := range rows {
									@table.Row() {
										for _, cell := range row {
											@table.Cell(table.CellProps{Attributes: templ.Attributes{"title": cell}}) {
												<div class="cell-inner">
													<span class="cell-text">{ truncate(cell, maxCellChars) }</span>
													@CopyButton(cell)
												</div>
											}
										}
									}
								}
							}
						}
					</div>
				}
			}
		}
	}
}

func truncate(s string, max int) string {
	if utf8.RuneCountInString(s) <= max {
		return s
	}
	runes := []rune(s)
	return string(runes[:max]) + "…"
}

func parentURL(filePath string) string {
	dir := path.Dir(filePath)
	if dir == "." {
		return "/"
	}
	return "/browse/" + dir
}
